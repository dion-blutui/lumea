{% canopy config %}
{
    "title": "Feature card",
    "name": "feature-card",
    "settings": [
        {
            "name": "label",
            "type": "text",
            "label": "Label",
            "default": "01 / Deep Aqua",
            "help": "Small uppercase label above the title"
        },
        {
            "name": "title",
            "type": "text",
            "label": "Title",
            "default": "Hydrate"
        },
        {
            "name": "description",
            "type": "textarea",
            "label": "Description",
            "default": "Long-lasting, moisture-binding matrix that releases weightless water continuously without feeling heavy on the surface."
        }
    ]
}
{% endcanopy %}

{% canopy template %}
<article class="flex h-full flex-col gap-4 rounded-[20px] bg-white p-8 shadow-[0_12px_12px_rgba(28,27,25,0.02)]">
  <div class="flex flex-col gap-1.5">
    {% if settings.label %}
      <p class="text-[11px] font-bold tracking-[0.08em] text-moss uppercase">{{ settings.label }}</p>
    {% endif %}
    <h3 class="font-display text-[28px] font-medium text-ink">{{ settings.title }}</h3>
  </div>

  {% if settings.description %}
    <p class="text-[14px] leading-[1.6] text-muted">{{ settings.description }}</p>
  {% endif %}
</article>
{% endcanopy %}
